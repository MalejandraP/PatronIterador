<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="520" prefWidth="820" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.iteradorpatron.viewController.PrimaryViewController">
    <VBox spacing="18" AnchorPane.bottomAnchor="24" AnchorPane.leftAnchor="24" AnchorPane.rightAnchor="24" AnchorPane.topAnchor="24" styleClass="app-container">
        <Label text="Reproductor de Playlist" styleClass="app-title" />

        <HBox alignment="CENTER" spacing="24">
            <StackPane styleClass="album-art">
                <Label text="♪" style="-fx-text-fill: #9b9b9b; -fx-font-size: 64px;" />
            </StackPane>

            <VBox spacing="6">
                <Label fx:id="lblTitulo" text="Título de la canción" styleClass="track-title" />
                <Label fx:id="lblArtista" text="Artista" styleClass="track-artist" />

                <HBox spacing="8" styleClass="controls">
                    <Button fx:id="btnAnterior" onAction="#onAnteriorCancion" text="⏮ Anterior" styleClass="btn" />
                    <Button fx:id="btnSiguiente" onAction="#onSiguienteCancion" text="▶ Siguiente" styleClass="btn" />
                    <Button fx:id="btnReset" onAction="#onReset" text="🔄 Reiniciar" styleClass="btn" />
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</AnchorPane>
