<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="300" prefWidth="400" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.iteradorpatron.viewController.PrimaryViewController">

    <VBox alignment="CENTER" spacing="15" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <Label prefHeight="46.0" prefWidth="269.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Reproductor de Playlist">
         <font>
            <Font size="18.0" />
         </font></Label>

        <Label fx:id="lblTitulo" style="-fx-font-size: 16px;" text="Título de la canción" />
        <Label fx:id="lblArtista" style="-fx-font-size: 14px; -fx-text-fill: gray;" text="Artista" />

        <Button fx:id="btnSiguiente" onAction="#onSiguienteCancion" text="▶ Siguiente canción" />
        <Button fx:id="btnAnterior" onAction="#onAnteriorCancion" text="⏮ Anterior canción" />


    </VBox>
</AnchorPane>
